venv/
env/
ENV/
build/
dist/
pip-wheel-metadata/

# --- Rust ---
rust-audio/target/
rust-audio/Cargo.lock
**/*.rs.bk

# --- Tauri / Node ---
tauri-overlay/src-tauri/target/
